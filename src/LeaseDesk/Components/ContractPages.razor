@inject IJSRuntime JavaScript

<div class="studio-pages" id="@_hostId"></div>

@code {
    [Parameter]
    public int ContractId { get; set; }

    [Parameter]
    public int Revision { get; set; }

    [Parameter]
    public string? PageHtml { get; set; }

    [Parameter]
    public byte[]? DraftDocx { get; set; }

    [Parameter]
    public EventCallback Ready { get; set; }

    private readonly string _hostId = "lease-pages-" + Guid.NewGuid().ToString("N");
    private bool _painted;
    private int _loadedRevision = -1;
    private int _loadedId;

    protected override bool ShouldRender() => !_painted;

    protected override async Task OnParametersSetAsync()
    {
        if (_painted)
            await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _painted = true;
        await LoadAsync();
    }

    public Task<bool> WasEditedAsync() =>
        JavaScript.InvokeAsync<bool>("leaseDeskPreview.wasEdited", _hostId).AsTask();

    public Task MarkCleanAsync() =>
        JavaScript.InvokeVoidAsync("leaseDeskPreview.markClean", _hostId).AsTask();

    public Task<string> ReadHtmlAsync() =>
        JavaScript.InvokeAsync<string>("leaseDeskPreview.read", _hostId).AsTask();

    public Task DownloadAsync(string url) =>
        JavaScript.InvokeVoidAsync("leaseDeskPreview.download", _hostId, url).AsTask();

    public Task PrintAsync() =>
        JavaScript.InvokeVoidAsync("leaseDeskPreview.print", _hostId).AsTask();

    public Task SyncFieldsAsync(IReadOnlyList<object> updates) =>
        JavaScript.InvokeVoidAsync("leaseDeskPreview.syncFields", _hostId, updates).AsTask();

    private async Task LoadAsync()
    {
        var hasHtml = !string.IsNullOrWhiteSpace(PageHtml);
        var hasDraft = DraftDocx is { Length: > 0 };
        if (ContractId == 0 && !hasHtml && !hasDraft)
            return;

        if (_loadedId == ContractId && _loadedRevision == Revision)
            return;

        _loadedId = ContractId;
        _loadedRevision = Revision;
        await JavaScript.InvokeVoidAsync(
            "leaseDeskPreview.render",
            _hostId,
            ContractId == 0 ? null : $"/contracts/{ContractId}/word?preview=true",
            hasHtml ? PageHtml : null,
            hasHtml || DraftDocx is null ? null : Convert.ToBase64String(DraftDocx));

        if (Ready.HasDelegate)
            await Ready.InvokeAsync();
    }
}
