@page "/contracts/new"
@page "/contracts/{Id:int}"
@page "/contracts/{Id:int}/preview"
@inject LeaseContractService Contracts
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>@(IsNew ? "New contract" : "Edit contract")</PageTitle>

<section class="page-header">
    <div>
        <h1>@(IsNew ? "New contract" : "Edit contract") <small class="text-muted">@(Contract?.IsCustomDocument == true ? "Custom" : "Horizon lease")</small></h1>
        <p class="text-muted mb-0">@(IsNew ? "Start from the Horizon lease, or from a blank page. After that, the page itself can be written and changed." : Contract?.IsCustomDocument == true ? "Click the page and type. Enter starts a new paragraph, and the toolbar changes fonts, lists, and layout." : "Horizon lease is only the starting format. Click the page to add or rewrite any clause. Enter starts a new paragraph.")</p>
    </div>
    <div class="page-actions">
        @if (!IsNew && !_missing)
        {
            <button type="submit" form="contract-form" class="btn btn-primary">Save</button>
        }
        <a class="btn btn-outline-secondary" href="/">Back to contracts</a>
    </div>
</section>

@if (_missing)
{
    <div class="alert alert-warning" role="alert">
        That contract does not exist.
        <a href="/">Return to the list.</a>
    </div>
}
else if (IsNew)
{
    <div class="start-grid">
        <button type="button" class="start-card" @onclick="StartHorizonAsync">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
            <h2>Horizon lease</h2>
            <p>Open the lease format, then add, delete, or rewrite any clause on the page.</p>
        </button>
        <button type="button" class="start-card" @onclick="StartBlankAsync">
            <i class="bi bi-file-earmark" aria-hidden="true"></i>
            <h2>Blank page</h2>
            <p>Start from an empty page and write the contract yourself, the same way you would in a document.</p>
        </button>
    </div>
}
else if (Contract is not null)
{
    @if (!IsNew)
    {
        <div class="page-tools" aria-label="Page formatting">
            <button type="button" class="tool-btn" data-command="undo" title="Undo" aria-label="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
            <button type="button" class="tool-btn" data-command="redo" title="Redo" aria-label="Redo"><i class="bi bi-arrow-clockwise"></i></button>
            <span class="tool-gap"></span>
            <select data-command="formatBlock" aria-label="Style">
                <option value="" disabled selected>Style</option>
                <option value="p">Normal</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
            </select>
            <select data-command="fontName" aria-label="Font">
                <option value="" disabled selected>Font</option>
                <option>Times New Roman</option>
                <option>Georgia</option>
                <option>Garamond</option>
                <option>Cambria</option>
                <option>Calibri</option>
                <option>Arial</option>
                <option>Tahoma</option>
                <option>Courier New</option>
            </select>
            <select data-command="fontSize" aria-label="Font size">
                <option value="" disabled selected>Size</option>
                <option value="10pt">10</option>
                <option value="11pt">11</option>
                <option value="12pt">12</option>
                <option value="14pt">14</option>
                <option value="16pt">16</option>
                <option value="18pt">18</option>
                <option value="20pt">20</option>
                <option value="24pt">24</option>
                <option value="28pt">28</option>
                <option value="32pt">32</option>
            </select>
            <button type="button" class="tool-btn" data-command="bold" title="Bold" aria-label="Bold"><i class="bi bi-type-bold"></i></button>
            <button type="button" class="tool-btn" data-command="italic" title="Italic" aria-label="Italic"><i class="bi bi-type-italic"></i></button>
            <button type="button" class="tool-btn" data-command="underline" title="Underline" aria-label="Underline"><i class="bi bi-type-underline"></i></button>
            <input type="color" data-command="foreColor" value="#1a2744" title="Font color" aria-label="Font color" />
            <button type="button" class="tool-btn" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting"><i class="bi bi-eraser"></i></button>
            <span class="tool-gap"></span>
            <button type="button" class="tool-btn" data-command="justifyLeft" title="Align left" aria-label="Align left"><i class="bi bi-text-left"></i></button>
            <button type="button" class="tool-btn" data-command="justifyCenter" title="Align center" aria-label="Align center"><i class="bi bi-text-center"></i></button>
            <button type="button" class="tool-btn" data-command="justifyRight" title="Align right" aria-label="Align right"><i class="bi bi-text-right"></i></button>
            <button type="button" class="tool-btn" data-command="justifyFull" title="Justify" aria-label="Justify"><i class="bi bi-justify"></i></button>
            <button type="button" class="tool-btn" data-command="insertUnorderedList" title="Bullets" aria-label="Bullets"><i class="bi bi-list-ul"></i></button>
            <button type="button" class="tool-btn" data-command="insertOrderedList" title="Numbering" aria-label="Numbering"><i class="bi bi-list-ol"></i></button>
            <button type="button" class="tool-btn" data-command="pageBreak" title="Page break" aria-label="Page break"><i class="bi bi-file-break"></i></button>
            <select data-command="lineHeight" aria-label="Line spacing">
                <option value="" disabled selected>Spacing</option>
                <option value="1">1.0</option>
                <option value="1.15">1.15</option>
                <option value="1.5">1.5</option>
                <option value="2">2.0</option>
            </select>
            <span class="tool-gap"></span>
            <select data-command="paper" aria-label="Paper size">
                <option value="" disabled selected>Paper</option>
                <option value="letter">Letter</option>
                <option value="a4">A4</option>
            </select>
            <select data-command="margins" aria-label="Page margins">
                <option value="" disabled selected>Margins</option>
                <option value="narrow">Narrow</option>
                <option value="normal">Normal</option>
                <option value="wide">Wide</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary tool-rebuild" @onclick="RebuildPageAsync">Rebuild from fields</button>
            @if (!string.IsNullOrEmpty(Contract.PageHtml))
            {
                <p class="tool-note">This page keeps your wording. Rebuild from fields if the form should rewrite it.</p>
            }
        </div>
    }
    <div class="@(IsNew ? null : "studio")">
        @if (!IsNew)
        {
            <ContractPages @ref="_pages" ContractId="Contract.Id" Revision="_revision" PageHtml="@Contract.PageHtml" />
        }
        <div class="@(IsNew ? null : "studio-form")">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (!string.IsNullOrWhiteSpace(_saved))
    {
        <div class="alert alert-success" role="status">@_saved</div>
    }
    @if (!IsNew)
    {
        var gaps = LeaseDocumentService.MissingFields(Contract);
        <div class="studio-toolbar">
            @if (gaps.Count == 0)
            {
                <button type="button" class="btn btn-sm btn-primary" @onclick="DownloadWordAsync">Word</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DownloadPdfAsync">PDF</button>
            }
            else
            {
                <span class="text-muted small">Fill in @string.Join(", ", gaps) before downloading.</span>
            }
        </div>
    }

    <EditForm id="contract-form" EditContext="_editContext" OnSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Parties</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Lessor name</label>
                        <InputText class="form-control" @bind-Value="Contract.LessorName" />
                        <ValidationMessage For="() => Contract.LessorName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Representative <span class="text-muted">(optional)</span></label>
                        <InputText class="form-control" @bind-Value="Contract.LessorRepresentative" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Lessor address</label>
                        <InputText class="form-control" @bind-Value="Contract.LessorAddress" />
                        <ValidationMessage For="() => Contract.LessorAddress" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Lessee name</label>
                        <InputText class="form-control" @bind-Value="Contract.LesseeName" />
                        <ValidationMessage For="() => Contract.LesseeName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Lessee address</label>
                        <InputText class="form-control" @bind-Value="Contract.LesseeAddress" />
                        <ValidationMessage For="() => Contract.LesseeAddress" />
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Property</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Property</label>
                        <InputText class="form-control" @bind-Value="Contract.PropertyName" />
                        <ValidationMessage For="() => Contract.PropertyName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit</label>
                        <InputText class="form-control" @bind-Value="Contract.Unit" />
                        <ValidationMessage For="() => Contract.Unit" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Property address</label>
                        <InputText class="form-control" @bind-Value="Contract.PropertyAddress" />
                        <ValidationMessage For="() => Contract.PropertyAddress" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit type</label>
                        <InputText class="form-control" @bind-Value="Contract.UnitType" />
                        <ValidationMessage For="() => Contract.UnitType" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Maximum occupants</label>
                        <InputNumber class="form-control" @bind-Value="Contract.MaxOccupants" />
                        <ValidationMessage For="() => Contract.MaxOccupants" />
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Term and rent</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Start date</label>
                        <InputDate class="form-control" @bind-Value="Contract.StartDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Term (years)</label>
                        <InputNumber class="form-control" @bind-Value="Contract.TermYears" />
                        <ValidationMessage For="() => Contract.TermYears" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End date</label>
                        <input class="form-control" value="@Contract.EndDate.ToString("dd MMM yyyy")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Signing date</label>
                        <InputDate class="form-control" @bind-Value="Contract.SigningDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Signing place</label>
                        <InputText class="form-control" @bind-Value="Contract.SigningPlace" />
                        <ValidationMessage For="() => Contract.SigningPlace" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Monthly rent</label>
                        <InputNumber class="form-control" @bind-Value="Contract.MonthlyRent" @bind-Value:after="SyncReceipt" />
                        <div class="form-text">@PesoWords.Format(Contract.MonthlyRent)</div>
                        <ValidationMessage For="() => Contract.MonthlyRent" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Post-dated checks</label>
                        <InputNumber class="form-control" @bind-Value="Contract.PostDatedCheckCount" />
                        <ValidationMessage For="() => Contract.PostDatedCheckCount" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Advance (months)</label>
                        <InputNumber class="form-control" @bind-Value="Contract.AdvanceMonths" @bind-Value:after="SyncReceipt" />
                        <div class="form-text">@PesoWords.FormatMoney(Contract.AdvanceAmount) — @PesoWords.Format(Contract.AdvanceAmount)</div>
                        <ValidationMessage For="() => Contract.AdvanceMonths" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Security deposit (months)</label>
                        <InputNumber class="form-control" @bind-Value="Contract.SecurityDepositMonths" @bind-Value:after="SyncReceipt" />
                        <div class="form-text">@PesoWords.FormatMoney(Contract.SecurityDepositAmount) — @PesoWords.Format(Contract.SecurityDepositAmount)</div>
                        <ValidationMessage For="() => Contract.SecurityDepositMonths" />
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Payment receipt</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Amount received</label>
                        <InputNumber class="form-control" @bind-Value="Contract.ReceiptAmount" @bind-Value:after="MarkReceiptEdited" />
                        <div class="form-text">@PesoWords.Format(Contract.ReceiptAmount). Starts as advance plus deposit.</div>
                        <ValidationMessage For="() => Contract.ReceiptAmount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date received</label>
                        <InputDate class="form-control" @bind-Value="Contract.ReceiptDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Payer</label>
                        <InputText class="form-control" @bind-Value="Contract.ReceiptPayer" placeholder="Defaults to the lessee" />
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Witnesses</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First witness</label>
                        <InputText class="form-control" @bind-Value="Contract.WitnessOneName" />
                        <ValidationMessage For="() => Contract.WitnessOneName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Second witness</label>
                        <InputText class="form-control" @bind-Value="Contract.WitnessTwoName" />
                        <ValidationMessage For="() => Contract.WitnessTwoName" />
                    </div>
                </div>
            </div>
        </section>

    </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private LeaseContract? Contract { get; set; }
    private EditContext _editContext = new(new LeaseContract());
    private ContractPages? _pages;
    private bool _missing;
    private bool _receiptEdited;
    private string? _error;
    private string? _saved;
    private int _revision;

    private bool IsNew => Contract?.Id == 0;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _saved = null;
        _receiptEdited = false;

        if (Id is null)
        {
            Contract = LeaseContract.CreateHorizonDefault();
            return;
        }

        Contract = await Contracts.GetAsync(Id.Value);
        _missing = Contract is null;
        if (Contract is not null)
        {
            _editContext = new EditContext(Contract);
            var computed = Contract.AdvanceAmount + Contract.SecurityDepositAmount;
            _receiptEdited = Contract.ReceiptAmount != computed;
        }
    }

    private async Task StartHorizonAsync()
    {
        var contract = await Contracts.SaveAsync(LeaseContract.CreateHorizonDefault());
        Navigation.NavigateTo($"/contracts/{contract.Id}");
    }

    private async Task StartBlankAsync()
    {
        var contract = await Contracts.SaveAsync(LeaseContract.CreateBlank());
        Navigation.NavigateTo($"/contracts/{contract.Id}");
    }

    private void SyncReceipt()
    {
        if (Contract is null || _receiptEdited)
            return;

        Contract.ReceiptAmount = Contract.AdvanceAmount + Contract.SecurityDepositAmount;
    }

    private void MarkReceiptEdited() => _receiptEdited = true;

    private async Task RebuildPageAsync()
    {
        if (Contract is null)
            return;

        var confirmed = await JavaScript.InvokeAsync<bool>("confirm", "Replace the page with the Horizon lease wording from the form fields? Anything you added on the page will be removed.");
        if (!confirmed)
            return;

        Contract.PageHtml = null;
        if (_pages is not null)
            await _pages.MarkCleanAsync();
        await SaveAsync(skipPageCapture: true);
    }

    private async Task DownloadWordAsync()
    {
        if (Contract is null || _pages is null)
            return;

        await _pages.DownloadAsync($"/contracts/{Contract.Id}/word?pages=true");
    }

    private Task DownloadPdfAsync() =>
        _pages is null || Contract is null
            ? Task.CompletedTask
            : _pages.DownloadAsync($"/contracts/{Contract.Id}/pdf");

    private async Task SaveAsync() => await SaveAsync(skipPageCapture: false);

    private async Task SaveAsync(bool skipPageCapture)
    {
        if (Contract is null)
            return;

        if (!skipPageCapture && !await CapturePageAsync())
            return;

        _error = null;
        _saved = null;
        var wasNew = Contract.Id == 0;

        try
        {
            await Contracts.SaveAsync(Contract);
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
            return;
        }

        if (wasNew)
        {
            Navigation.NavigateTo($"/contracts/{Contract.Id}");
            return;
        }

        if (string.IsNullOrEmpty(Contract.PageHtml))
            _revision++;
        else if (_pages is not null)
            await _pages.MarkCleanAsync();

        var fieldsReady = Contract.IsCustomDocument || _editContext.Validate();
        _saved = fieldsReady
            ? "Saved."
            : "The page was saved. Finish the highlighted fields before downloading.";
    }

    private async Task<bool> CapturePageAsync()
    {
        if (Contract is null || _pages is null || !await _pages.WasEditedAsync())
            return true;

        var html = await _pages.ReadHtmlAsync();
        if (string.IsNullOrWhiteSpace(html))
            return true;
        if (html.Length > 2_000_000)
        {
            _error = "The page is too large to save. Shorten it and try again.";
            _saved = null;
            return false;
        }

        Contract.PageHtml = html;
        return true;
    }
}
